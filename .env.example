# Supabase Configuration
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Admin Dashboard Security (REQUIRED - minimum 8 chars; admin fails closed with 503 if missing)
ADMIN_PASSWORD=

# Telegram Bot Broadcasting (Optional - skipped gracefully if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Market Scraping Source (Optional - public Telegram channel web preview URL e.g. https://t.me/s/your_channel)
SOLAR_SOURCE_URL=

# Google Search Console Verification
GOOGLE_SITE_VERIFICATION=
